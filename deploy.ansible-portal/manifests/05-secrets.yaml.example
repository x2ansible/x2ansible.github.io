# Secrets for the Path-1 X2A install. COPY this file to `05-secrets.yaml`, fill in
# the real values, and keep the real file OUT of git (it is gitignored — see the
# .gitignore entry added for this guide). Only this `.example` is committed.
#
# Four secrets are involved. Two of them are created by scripts/deploy.sh from
# cluster/local sources rather than from this file, and are shown here only for
# reference:
#
#   * x2a-ca-bundle       (ca-bundle.crt)  -> built by deploy.sh from the cluster's
#                                             kube-root-ca.crt ConfigMap. Do not hand-author.
#   * portal-registry-auth (auth.json)     -> built by deploy.sh from your local
#                                             registry.redhat.io pull credentials (see README
#                                             Step 3). MUST carry the key `auth.json` (skopeo
#                                             searches for auth.json, not .dockerconfigjson).
#
# The two you edit here:
---
# GitHub OAuth App credentials (Phase-1 sign-in). Create the OAuth App first.
apiVersion: v1
kind: Secret
metadata:
  name: x2a-github-oauth
  namespace: automation-portal
type: Opaque
stringData:
  client-id: <changeme-github-oauth-client-id>
  client-secret: <changeme-github-oauth-client-secret>
---
# Placeholder AAP credentials. `spec.aap` is schema-required even in Phase 1, but the
# operator never contacts this host at reconcile time, so an unreachable placeholder is
# fine. Required keys: aap-host-url, oauth-client-id, oauth-client-secret, aap-token.
# In Phase 2, replace with real AAP gateway values.
apiVersion: v1
kind: Secret
metadata:
  name: secrets-rhaap-portal
  namespace: automation-portal
type: Opaque
stringData:
  aap-host-url: https://aap-placeholder.invalid
  oauth-client-id: <changeme-or-placeholder>
  oauth-client-secret: <changeme-or-placeholder>
  aap-token: <changeme-or-placeholder>
